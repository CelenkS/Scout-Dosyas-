rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Giriş yok: veriler tahmin edilemez gizli bir koda (space) bağlı alanda durur.
    // Kodu bilmeyen alanı bulamaz; alanlar listelenemez.
    match /spaces/{space}/kv/{key} {
      allow read, write: if space.size() >= 16;
    }
  }
}
